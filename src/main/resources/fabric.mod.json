{
  "schemaVersion": 1,
  "id": "aichat",
  "version": "${version}",
  "name": "AiChat",
  "description": "Chat with a locally deployed AI model from Ollama in Minecraft.",
  "authors": [
    ""
  ],
  "contact": {
    "homepage": "https://github.com/Pei-xiao-xiao/Forge-ollamaChat",
    "sources": "https://github.com/Pei-xiao-xiao/Forge-ollamaChat",
    "issues": "https://github.com/Pei-xiao-xiao/Forge-ollamaChat/issues"
  },
  "donate": "kongbai",
  "license": "MIT",
  "icon": "assets/aichat/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "fun.aichat.Aichat"
    ],
    "client": [
      "fun.aichat.client.AichatClient"
    ],
    "server": [
      "fun.aichat.server.AichatServer"
    ]
  },
  "mixins": [
    "aichat.mixins.json",
    {
      "config": "aichat.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.kofi": "kongbai",
        "modmenu.afadian": "kongbai"
      }
    }
  }
}
